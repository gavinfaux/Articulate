<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UseArticulateUsings>true</UseArticulateUsings>
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <UmbracoJsonSchemaGenerateEnabled>false</UmbracoJsonSchemaGenerateEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MessagePack" PrivateAssets="All" />
    <PackageReference Include="Moq" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="SixLabors.ImageSharp" ExcludeAssets="build" />
    <PackageReference Include="SixLabors.ImageSharp.Web" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
  </ItemGroup>

  <!-- Umbraco.Code 3 allows Roslyn 5.x but NuGet otherwise selects Workspaces 5.0. Align it with Umbraco 18's compiler 5.3 packages. -->

  <ItemGroup>
    <ProjectReference Include="..\Articulate\Articulate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.Tests.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="appsettings.Tests.Local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
