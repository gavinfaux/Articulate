{
  "name": "articulate-backoffice-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter articulate-backoffice-v17 run dev",
    "build": "pnpm --filter articulate-backoffice-v17 run build build",
    "build:dev": "pnpm --filter articulate-backoffice-v17 run build:dev build:dev",
    "check": "pnpm --filter articulate-backoffice-v17 run check check",
    "lint": "pnpm --filter articulate-backoffice-v17 run lint lint",
    "lint:fix": "pnpm --filter articulate-backoffice-v17 run lint:fix lint:fix",
    "generate:api:v17": "pnpm --filter articulate-backoffice-v17 run generate:api"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.3",
    "@types/node": "^24",
    "@umbraco-cms/backoffice": "^17.6.2",
    "vite": "^8.2.0"
  }
}
